# Admin wallet — deployer of all FoggyPot contracts (owner of Vault/Ledger/Reserve/PrizePool
# wiring, runs runDraw() as fallback if Chainlink Automation isn't registered yet).
ADMIN_PRIVATE_KEY=0x...

# Two depositor wallets used to demonstrate a draw with more than one participant. Each needs a
# little Sepolia ETH for gas (faucet/deposit/withdraw are real transactions).
ALICE_PRIVATE_KEY=0x...
BOB_PRIVATE_KEY=0x...

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

